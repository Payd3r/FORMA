# Optional frontend API override; leave empty to use the same-origin /api proxy.
VITE_API_URL=

# Development proxy only (vite.config.ts).
FITNESS_DEV_API_TARGET=http://127.0.0.1:3001

# Optional server-to-server API token, read by Docker Compose.
# Generate your own value; never commit the real .env file.
SERVICE_API_TOKEN=
